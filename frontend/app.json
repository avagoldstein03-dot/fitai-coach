{
  "expo": {
    "name": "FitAI Coach",
    "slug": "fitai-coach",
    "version": "1.0.0",
    "scheme": "fitai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.fitai.coach",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "FitAI Coach uses your camera to capture body scan photos for AI-powered body composition analysis.",
        "NSPhotoLibraryUsageDescription": "FitAI Coach accesses your photo library to upload progress photos and body scan images.",
        "NSPhotoLibraryAddUsageDescription": "FitAI Coach saves progress photos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.fitai.coach",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload progress photos and body scan images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for AI-powered body scan analysis."
        }
      ],
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.fitai.coach",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "fitai-coach"
      }
    }
  }
}
