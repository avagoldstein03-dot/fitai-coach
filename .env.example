# Backend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql://fitai:password@localhost:5432/fitai_coach
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# AI Providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Storage
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=fitai-coach-storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Payments
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# RevenueCat webhook (iOS/Android subscription sync) — set the same value in the
# RevenueCat dashboard under Project Settings → Integrations → Webhooks
REVENUECAT_WEBHOOK_SECRET=a_long_random_secret_string

# Analytics
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_API_HOST=https://app.posthog.com

# Firebase Cloud Messaging (push notifications)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Cron secret — used to protect /api/notifications/cron from public calls
CRON_SECRET=a_long_random_secret_string

# Rate limiting — free tier at https://upstash.com (create a Redis database, copy REST URL/token)
# If unset, rate limiting fails open (disabled) so local dev works without it
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Admin
ADMIN_CLERK_IDS=clerk_user_id_1,clerk_user_id_2

# Frontend Environment Variables
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id
# RevenueCat public SDK keys — RevenueCat dashboard → Project Settings → API Keys
# (App Store key for iOS, Play Store key for Android; both platforms use these to
# purchase through native store billing rather than Stripe)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_public_sdk_key
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_api_key
# Get from: https://expo.dev → your project → Project ID
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id

# Development
NODE_ENV=development
DEBUG=true

